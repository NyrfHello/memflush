#!/usr/bin/env bash
# ==============================================================================
# memflush — Advanced Linux Memory Compaction & Cache Flush Utility
# Proactively reclaims cold process memory into ZRAM, defragments memory zones,
# and flushes kernel page caches, dentries, and inodes.
# ==============================================================================

set -euo pipefail

VERSION="1.1.0"

# Text styling
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_GREEN="\033[32m"
    C_BLUE="\033[34m"
    C_YELLOW="\033[33m"
    C_CYAN="\033[36m"
else
    C_RESET=""
    C_BOLD=""
    C_GREEN=""
    C_BLUE=""
    C_YELLOW=""
    C_CYAN=""
fi

DO_NOTIFY=1
DO_PRINT=1

show_help() {
    echo -e "${C_BOLD}memflush${C_RESET} — Linux Memory Compaction & Cache Flush Utility (v${VERSION})"
    echo ""
    echo -e "${C_BOLD}USAGE:${C_RESET}"
    echo -e "    memflush [OPTIONS]"
    echo ""
    echo -e "${C_BOLD}OPTIONS:${C_RESET}"
    echo -e "    ${C_GREEN}-n, --no-notify${C_RESET}   Run in terminal only (skips desktop notification)"
    echo -e "    ${C_GREEN}-s, --silent${C_RESET}      Run completely silent (no terminal text, no notification)"
    echo -e "    ${C_GREEN}-q, --quiet${C_RESET}       Alias for --silent (ideal for autostart & cron)"
    echo -e "    ${C_GREEN}-v, --version${C_RESET}     Display version information"
    echo -e "    ${C_GREEN}-h, --help${C_RESET}        Show this help message"
    echo ""
    echo -e "${C_BOLD}EXAMPLES:${C_RESET}"
    echo -e "    memflush              # Standard run (terminal stats + desktop notification)"
    echo -e "    memflush --no-notify  # CLI-only mode (great for SSH or scripting)"
    echo -e "    memflush --silent     # Silent mode (great for desktop hotkeys and boot autostart)"
    echo ""
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "memflush v${VERSION}"
            exit 0
            ;;
        -n|--no-notify)
            DO_NOTIFY=0
            shift
            ;;
        -s|--silent|-q|--quiet)
            DO_NOTIFY=0
            DO_PRINT=0
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Run 'memflush --help' for usage." >&2
            exit 1
            ;;
    esac
done

# If stdout is not a TTY and user didn't explicitly request printing, suppress terminal text
if [ ! -t 1 ] && [ "$DO_PRINT" -eq 1 ]; then
    DO_PRINT=0
fi

# Environment checks for notifications
if [ "$DO_NOTIFY" -eq 1 ]; then
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
fi

# 1. Read memory before flushing (in MiB)
MEM_TOTAL=$(free -m | awk '/^Mem:/ {print $2}')
CACHE_BEFORE=$(free -m | awk '/^Mem:/ {print $6}')

if [ "$DO_PRINT" -eq 1 ]; then
    echo -e "${C_BLUE}[memflush]${C_RESET} Measuring system memory..."
    echo -e "           Cached: ${C_YELLOW}${CACHE_BEFORE} MB${C_RESET} / Total RAM: ${MEM_TOTAL} MB"
    echo -e "${C_BLUE}[memflush]${C_RESET} Trimming cold memory, compacting zones, and dropping caches..."
fi

# 2. Trigger 3-stage memory trim (systemd service, direct root, pkexec, or sudo)
# Stage A: Proactive cgroup reclaim into ZRAM (echo 300M > /sys/fs/cgroup/memory.reclaim)
# Stage B: Proactive memory compaction (echo 1 > /proc/sys/vm/compact_memory)
# Stage C: Drop page cache and dentries (sync; echo 3 > /proc/sys/vm/drop_caches)

FLUSHED=0

if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet memflush.service 2>/dev/null || systemctl start memflush.service 2>/dev/null; then
    FLUSHED=1
elif [ "${EUID:-$(id -u)}" -eq 0 ]; then
    echo 300M > /sys/fs/cgroup/memory.reclaim 2>/dev/null || true
    echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true
    sync && echo 3 > /proc/sys/vm/drop_caches
    FLUSHED=1
elif command -v pkexec >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
    pkexec sh -c "echo 300M > /sys/fs/cgroup/memory.reclaim 2>/dev/null || true; echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true; sync; echo 3 > /proc/sys/vm/drop_caches" 2>/dev/null && FLUSHED=1 || true
fi

# Fallback to sudo if still not flushed
if [ "$FLUSHED" -eq 0 ]; then
    CMD="echo 300M > /sys/fs/cgroup/memory.reclaim 2>/dev/null || true; echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true; sync; echo 3 > /proc/sys/vm/drop_caches"
    if sudo -n sh -c "$CMD" 2>/dev/null; then
        FLUSHED=1
    elif sudo sh -c "$CMD"; then
        FLUSHED=1
    else
        echo -e "${C_YELLOW}[memflush] Warning: Failed to obtain root privileges to trim memory.${C_RESET}" >&2
        exit 1
    fi
fi

# 3. Read memory after flushing
CACHE_AFTER=$(free -m | awk '/^Mem:/ {print $6}')
AVAIL_MIB=$(free -m | awk '/^Mem:/ {print $7}')

# Human-readable available memory
if [ "$AVAIL_MIB" -ge 1024 ]; then
    AVAIL_STR=$(awk "BEGIN {printf \"%.1f GB\", $AVAIL_MIB / 1024}")
else
    AVAIL_STR="${AVAIL_MIB} MB"
fi

DIFF=$(( CACHE_BEFORE - CACHE_AFTER ))
if [ "$DIFF" -lt 0 ]; then
    DIFF=0
fi

# Human-readable freed memory
if [ "$DIFF" -ge 1024 ]; then
    FREED_STR=$(awk "BEGIN {printf \"%.1f GB\", $DIFF / 1024}")
else
    FREED_STR="${DIFF} MB"
fi

# 4. Terminal output
if [ "$DO_PRINT" -eq 1 ]; then
    if [ "$DIFF" -gt 0 ]; then
        echo -e "${C_GREEN}[memflush] Success!${C_RESET} Reclaimed: ${C_BOLD}${C_GREEN}${FREED_STR}${C_RESET} | Available: ${C_BOLD}${AVAIL_STR}${C_RESET} (Total: ${MEM_TOTAL} MB)"
    else
        echo -e "${C_GREEN}[memflush] Memory already optimal!${C_RESET} Available: ${C_BOLD}${AVAIL_STR}${C_RESET} (Total: ${MEM_TOTAL} MB)"
    fi
fi

# 5. Desktop notification
if [ "$DO_NOTIFY" -eq 1 ] && command -v notify-send >/dev/null 2>&1; then
    if [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
        if [ "$DIFF" -gt 0 ]; then
            notify-send -u normal -i utilities-system-monitor "Memory Flushed" "Freed ${FREED_STR} (Available: ${AVAIL_STR})"
        else
            notify-send -u normal -i utilities-system-monitor "Memory Optimal" "RAM is clean (Available: ${AVAIL_STR})"
        fi
    fi
fi
