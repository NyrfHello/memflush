# Maintainer: NyrfHello <https://github.com/NyrfHello>
pkgname=memflush
pkgver=1.1.0
pkgrel=1
pkgdesc="Advanced Linux memory compaction, cgroup reclaim into ZRAM, and cache flush utility"
arch=('any')
url="https://github.com/NyrfHello/memflush"
license=('MIT')
depends=('bash' 'systemd' 'procps-ng')
optdepends=(
    'libnotify: Desktop notification support (notify-send)'
)
backup=(
    'etc/polkit-1/rules.d/99-memflush.rules'
    'etc/sudoers.d/memflush'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/memflush" 2>/dev/null || cd "$startdir"
    make DESTDIR="$pkgdir" PREFIX="/usr" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
